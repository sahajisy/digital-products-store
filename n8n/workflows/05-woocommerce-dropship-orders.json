{
  "name": "05 - WooCommerce Dropship Orders",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "woo-orders-REPLACE_WITH_RANDOM_STRING",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000001",
      "name": "Woo Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "store-woo-orders"
    },
    {
      "parameters": {
        "jsCode": "// WooCommerce posts the order as the JSON body. The ping sent when the webhook is created has no order id, so it is ignored.\nconst o = $input.first().json.body || {};\nif (!o.id) return [];\nconst b = o.billing || {};\nconst s = (o.shipping && o.shipping.address_1) ? o.shipping : b;\nconst lines = o.line_items || [];\nconst items = lines.map((i) => `${i.quantity} x ${i.name}${i.sku ? ' [' + i.sku + ']' : ''}`);\nconst shipTo = [`${s.first_name || ''} ${s.last_name || ''}`.trim(), s.address_1, s.address_2, s.city, s.state, s.postcode, s.country]\n  .filter((x) => x && String(x).trim()).join(', ');\nreturn [{ json: {\n  order_key: 'woo-' + o.id,\n  id: o.id,\n  status: o.status,\n  email: (b.email || '').trim().toLowerCase(),\n  customer: `${b.first_name || ''} ${b.last_name || ''}`.trim(),\n  phone: b.phone || s.phone || '',\n  total: o.total,\n  currency: o.currency,\n  payment: o.payment_method_title || o.payment_method || '',\n  cod: o.payment_method === 'cod',\n  items: items.join('\\n'),\n  skus: lines.map((i) => i.sku || i.product_id).join(', '),\n  ship_to: shipTo,\n  admin_url: `https://wabisabivibe.store/wp-admin/admin.php?page=wc-orders&action=edit&id=${o.id}`\n} }];"
      },
      "id": "e5000000-0000-4000-8000-000000000002",
      "name": "Normalize Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c-status",
              "leftValue": "={{ $json.status }}",
              "rightValue": "processing",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000003",
      "name": "Is Processing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Orders"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "session_id",
              "lookupValue": "={{ $('Normalize Order').first().json.order_key }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000004",
      "name": "Find Existing Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        200
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c-new",
              "leftValue": "={{ $json.session_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000005",
      "name": "Is New Order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "=🛒 New order #{{ $('Normalize Order').first().json.id }} to fulfil on AliExpress\n{{ $('Normalize Order').first().json.items }}\n\nShip to: {{ $('Normalize Order').first().json.ship_to }}\nCustomer: {{ $('Normalize Order').first().json.customer }} · {{ $('Normalize Order').first().json.email }} · {{ $('Normalize Order').first().json.phone }}\nTotal: {{ $('Normalize Order').first().json.total }} {{ $('Normalize Order').first().json.currency }} · {{ $('Normalize Order').first().json.payment }}{{ $('Normalize Order').first().json.cod ? ' (CASH ON DELIVERY - confirm before ordering)' : '' }}\nOpen in WooCommerce: {{ $('Normalize Order').first().json.admin_url }}\nOrder each item from its AliExpress page using the shipping address above, then add the tracking number to the order.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "e5000000-0000-4000-8000-000000000006",
      "name": "Alert Owner - Fulfil Order",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        120
      ],
      "webhookId": "store-telegram-woo-order",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Orders"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "session_id": "={{ $('Normalize Order').first().json.order_key }}",
            "created_at": "={{ $now.toISO() }}",
            "email": "={{ $('Normalize Order').first().json.email }}",
            "sku": "={{ $('Normalize Order').first().json.skus }}",
            "amount": "={{ $('Normalize Order').first().json.total }}",
            "currency": "={{ $('Normalize Order').first().json.currency }}",
            "status": "awaiting_supplier_order"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000007",
      "name": "Log Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1320,
        120
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
